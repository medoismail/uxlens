{
  "name": "uxlens",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "portless uxlens next dev",
    "dev:legacy": "next dev",
    "build": "next build",
    "build:mcp": "cd packages/mcp-server && npm run build",
    "start": "next start",
    "lint": "eslint",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@clerk/nextjs": "^7.0.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@opennextjs/cloudflare": "^1.20.0",
    "@react-pdf/renderer": "^4.3.2",
    "@sparticuz/chromium-min": "^143.0.4",
    "@supabase/supabase-js": "^2.99.0",
    "@upstash/redis": "^1.36.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "interface-kit": "^0.1.3",
    "lucide-react": "^0.577.0",
    "motion": "^12.38.0",
    "next": "16.2.9",
    "openai": "^6.27.0",
    "puppeteer-core": "^24.39.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.0.2",
    "svix": "^1.86.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "pg": "^8.20.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.104.0"
  }
}
